{
  "name": "vasunthara",
  "version": "0.1.0",
  "description": "Vasunthara - read the pool, rule the hook. The Uniswap V4 execution layer for KeeperHub: pool state, position state and hook-aware quotes by poolId, deterministic strategy decisions, and swaps executed through KeeperHub with verifiable receipts.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zkasuran/vasunthara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkasuran/vasunthara.git"
  },
  "bugs": {
    "url": "https://github.com/zkasuran/vasunthara/issues"
  },
  "keywords": [
    "uniswap",
    "uniswap-v4",
    "hooks",
    "defi",
    "automation",
    "poolid",
    "stateview",
    "limit-orders",
    "rebalancing",
    "keeperhub",
    "ethereum"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "vasunthara": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "proof": "tsx src/cli.ts",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "demo": "tsx src/demo.ts",
    "sync:site": "node scripts/sync-site-lib.mjs",
    "check:site": "node scripts/sync-site-lib.mjs --check",
    "verify": "npm run typecheck && npm test && npm run lint && npm run check:site",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "ethers": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "ethers": "^6.17.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
